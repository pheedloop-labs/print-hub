# Python
__pycache__/
*.pyc
.venv/

# Local tool state, not shared
.claude/settings.local.json

# Renderer binaries. Provisioned on the box, never committed.
# SumatraPDF is GPLv3 and is a spike accelerator only; PDFium arrives via
# the pypdfium2 wheel in the venv, so neither belongs in the repo.
SumatraPDF.exe
libmupdf.dll
PdfFilter.dll
PdfPreview.dll
SumatraPDF-settings.txt
sumatra/

# Captured DEVMODE blobs. Machine- and queue-specific, and the vendor bytes
# are opaque, so they are restore points on this box rather than source.
devmode/
*.devmode

# Service bits. nssm is a downloaded binary; the log is runtime output and
# is the only way to see a Session 0 failure, so it must exist but not ship.
nssm.exe
service.log
# nssm rotates to service-<timestamp>.log, which service.log.* misses
service*.log

# Print artifacts, all regenerated on demand.
# spool/ holds delivered job PDFs; out.pdf is the HUB-PDF file port target
# and is overwritten by every print.
spool/
out.pdf
*.prn

# Vendor driver installers, ~400 MB. Downloaded per printer and needed to
# rebuild a box, but they are redistributable binaries, not our source.
# Currently: Brother QL-800, EPSON CW-C4000u, DYMO Connect, Zebra ZC10L,
# Zebra ZD621.
Drivers/

# Console build toolchain. Node is a dev-machine dependency only.
# printhub/static/ (the build output) IS committed on purpose: a hub must be
# standable on a plain machine with Python and nothing else (ENG-3790), and
# hub.ps1 status flags the build going stale against console/src.
console/node_modules/
console/.vite/
